# =============================================================================
# Fluxo Royale — Backend | Variáveis de Ambiente
# Copie para .env (nunca comite o .env real) e preencha os valores.
# =============================================================================

# --- Núcleo (obrigatórias) ---
# String de conexão do PostgreSQL (Neon). Use a "External" em produção.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Segredo do JWT. DEVE ser um valor longo e aleatório em produção.
# Sem ele, o sistema usa um fallback inseguro (qualquer um forja token admin).
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Ambiente: "production" ativa SSL do banco e o modo produção.
NODE_ENV=development

# Porta do servidor HTTP (Render injeta automaticamente em produção).
PORT=3000

# --- Rastreamento de encomendas (Wonca) ---
# Chave da API Wonca. NÃO versione a chave — configure aqui/no painel do host.
WONCA_API_KEY=

# --- Integração Google Drive / Sheets (webhook de arquivos) ---
# JSON de credenciais da conta de serviço (string única).
GOOGLE_CREDENTIALS=
# URL pública desta API que recebe o webhook do Google Drive.
WEBHOOK_URL=

# --- Notificações WhatsApp (Green API) ---
GREEN_API_URL=
GREEN_API_ID=
GREEN_API_TOKEN=
# Telefone do almoxarifado para alertas.
ALMOXARIFADO_PHONE=

# --- Web Push (opcional — hoje não configurado) ---
# Necessárias para notificações push funcionarem de verdade. Gere com:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@fluxo-royale.com.br
